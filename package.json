{
  "name": "trivia-bot-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The org daemon: stateless OpenAI agents running Trivia Bot's company brain against the shared Supabase database (PRD §9 contract).",
  "scripts": {
    "once": "tsx src/cli.ts once",
    "dryrun": "tsx src/cli.ts dryrun",
    "daemon": "tsx src/cli.ts daemon",
    "seed:signup": "tsx src/cli.ts seed-signup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
