# The daemon's credentials. NEVER commit the real .env.
OPENAI_API_KEY=
SUPABASE_URL=https://oiwjmmnjjeodbwozbvhu.supabase.co
# The service-role secret — the daemon's key by design (the app never holds it).
SUPABASE_SECRET_KEY=

# dry = reads are real, writes/emails land in outbox/ as would-do records.
# live = writes execute (email still outboxes until mail creds exist).
ORG_MODE=dry

# Inference. gpt-5-mini is the working default; upgrade per-role later (Phase C).
ORG_MODEL=gpt-5-mini

# Budgets (policies §2): hard stops, checked before and during every run.
DAILY_BUDGET_USD=5
MAX_RUN_USD=1

# Path to the doctrine repo (layer 1 of the brain).
BRAIN_PATH=../trivia-bot-brain

# Where the CEO's daily brief is addressed (delivery = outbox until mail creds).
OWNER_EMAIL=james@syzygy.services

# Publishable (anon) key — only the seed-signup helper uses it.
SUPABASE_PUBLISHABLE_KEY=

# ── Cloud host only (Railway) ──
# Fine-grained GitHub PAT (Contents: read-only on trivia-bot-brain). The cloud
# boot fetches doctrine as a tarball (scripts/fetch-brain.mjs) since containers
# have no sibling checkout. Leave empty locally — the checkout is used directly.
GITHUB_TOKEN=
